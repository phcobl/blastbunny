GLOBAL_CONSTANT = 1
Global_Variable = 2

function loveYourself()
    local CONSTANT_DETERMINATION = true
    local is_true = false

    if not is_true then
        if CONSTANT_DETERMINATION then
            is_true = true
        end
    end
end

function coolClass()
